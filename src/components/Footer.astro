---
const navLinks = [
  { name: 'About', href: '#about' },
  { name: 'Accolades', href: '#accolades' },
  { name: 'Research', href: '#research' },
  { name: 'Gallery', href: '#gallery' },
];
---

<footer id="contact" class="relative bg-navy-950 text-white pt-24 pb-12 px-6 lg:px-10 overflow-hidden">
  
  <!-- Decorative Top Line -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold-500/50 to-transparent"></div>

  <div class="max-w-7xl mx-auto">
    
    <!-- Main Grid -->
    <div class="grid lg:grid-cols-12 gap-12 pb-16 border-b border-white/10">
      
      <!-- Brand -->
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-14 h-14 rounded-full border-2 border-gold-500 flex items-center justify-center bg-navy-900">
            <span class="font-serif font-bold text-xl text-gold-500">PK</span>
          </div>
          <div>
            <p class="font-serif font-bold text-white text-xl">Dr. Pramod Kumar</p>
            <p class="text-xs text-slate-500 tracking-widest uppercase">Educator & Mentor</p>
          </div>
        </div>
        <p class="text-slate-400 leading-relaxed mb-6 max-w-md">
          Senior Master (Training) & HOD, Life Science at Sainik School Nalanda, 
          Ministry of Defence, Government of India.
        </p>
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-gold-500/10 border border-gold-500/30">
          <span class="w-2 h-2 rounded-full bg-gold-500 animate-pulse"></span>
          <span class="text-gold-500 text-xs font-medium tracking-wider uppercase">National Awardee 2025</span>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="lg:col-span-3">
        <p class="text-xs font-bold text-white uppercase tracking-[0.2em] mb-6">Navigate</p>
        <ul class="space-y-3">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-slate-400 hover:text-gold-500 transition-colors 
                                          inline-flex items-center gap-2 group">
                <span class="w-0 h-px bg-gold-500 group-hover:w-4 transition-all duration-300"></span>
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="lg:col-span-4">
        <p class="text-xs font-bold text-white uppercase tracking-[0.2em] mb-6">Get in Touch</p>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" 
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 class="text-gold-500 flex-shrink-0 mt-0.5">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <a href="mailto:dkpramodkumar@gmail.com" class="text-slate-400 hover:text-gold-500 transition-colors text-sm break-all">
              dkpramodkumar@gmail.com
            </a>
          </li>
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" 
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 class="text-gold-500 flex-shrink-0 mt-0.5">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <a href="tel:+919973715354" class="text-slate-400 hover:text-gold-500 transition-colors text-sm">
              +91 99737 15354
            </a>
          </li>
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" 
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 class="text-gold-500 flex-shrink-0 mt-0.5">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span class="text-slate-400 text-sm leading-relaxed">
              Sainik School Nalanda<br />
              Village Nanand, PO Pawapuri<br />
              District Nalanda, Bihar - 803115
            </span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-slate-500">
      <p>© {new Date().getFullYear()} Dr. Pramod Kumar. All rights reserved.</p>
      <p class="flex items-center gap-2">
        Crafted with 
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" 
             fill="currentColor" class="text-gold-500">
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
        </svg>
        By Akash Srivastva
      </p>
    </div>

  </div>
</footer>