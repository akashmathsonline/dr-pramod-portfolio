---
// Hero Component with Presidential Citation Badge & Defence Honors
---

<section class="relative min-h-screen flex items-center bg-gradient-to-br from-navy-950 via-navy-900 to-navy-950 overflow-hidden pt-32 pb-24">
  
  <!-- Subtle Tri-Color Top Accent Line (Honor of National Award) -->
  <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#FF9933] via-[#FFFFFF] to-[#138808] opacity-80 z-20"></div>

  <!-- Decorative Gradient Orbs -->
  <div class="absolute top-20 -left-40 w-96 h-96 bg-royal-500/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 -right-40 w-96 h-96 bg-gold-500/15 rounded-full blur-3xl pointer-events-none"></div>
  
  <!-- Subtle Grid Pattern -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none" 
       style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 60px 60px;"></div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-10 grid lg:grid-cols-12 gap-14 items-center">
    
    <!-- Left: Content -->
    <div class="lg:col-span-7 space-y-7">
      
      <!-- Presidential Award Pill -->
      <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full 
            bg-gold-500/10 border border-gold-500/40 backdrop-blur-md shadow-lg shadow-gold-500/10">
        <span class="flex h-2.5 w-2.5 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-gold-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-gold-500"></span>
        </span>
        <span class="text-gold-400 text-xs font-bold tracking-widest uppercase">
          National Teachers' Award 2025 • President of India
        </span>
      </div>

      <!-- Main Heading -->
      <h1 class="font-serif text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-[1.12]">
        Unlocking Potential,
        <br />
        <span class="italic text-transparent bg-clip-text bg-gradient-to-r from-gold-300 via-gold-400 to-gold-600">
          Changing Lives.
        </span>
      </h1>

      <!-- Subtitle Description -->
      <p class="text-lg md:text-xl text-slate-300 leading-relaxed max-w-2xl font-light">
        Senior Master & Head of Department, Life Science at 
        <span class="text-white font-medium border-b border-gold-500/40">Sainik School Nalanda</span> 
        (Ministry of Defence, Govt. of India). 
        With over <span class="text-gold-400 font-semibold">28+ years</span> 
        of inspiring scientific minds and mentoring 
        <span class="text-gold-400 font-semibold">2.5 Lakh+ educators</span> across India.
      </p>

      <!-- Credentials Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 text-xs text-slate-300">
        <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-xl px-3.5 py-2.5">
          <span class="w-2 h-2 rounded-full bg-gold-400"></span>
          <span>Ph.D. & Double Gold Medalist</span>
        </div>
        <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-xl px-3.5 py-2.5">
          <span class="w-2 h-2 rounded-full bg-gold-400"></span>
          <span>168+ Cadets into NDA</span>
        </div>
        <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-xl px-3.5 py-2.5">
          <span class="w-2 h-2 rounded-full bg-gold-400"></span>
          <span>CBSE & NCERT Master Trainer</span>
        </div>
      </div>

      <!-- CTA Action Row -->
      <div class="flex flex-wrap items-center gap-4 pt-4">
        <a 
          href="/contact" 
          class="group inline-flex items-center gap-3 px-8 py-4 rounded-full
                 bg-gradient-to-r from-gold-500 via-gold-500 to-gold-600
                 text-navy-950 font-bold text-sm uppercase tracking-wider
                 hover:shadow-2xl hover:shadow-gold-500/30 
                 transition-all duration-300 hover:-translate-y-1"
        >
          Connect with Dr. Kumar
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="group-hover:translate-x-1 transition-transform">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>

        <a 
          href="#timeline" 
          class="inline-flex items-center gap-2.5 px-7 py-4 rounded-full
                 border border-white/20 text-white font-medium text-sm uppercase tracking-wider
                 hover:bg-white/10 hover:border-gold-500/50 hover:text-gold-300 transition-all duration-300"
        >
          28+ Years Journey
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M19 12l-7 7-7-7"/>
          </svg>
        </a>

        <a 
          href="/gallery" 
          class="inline-flex items-center gap-2 text-sm text-slate-400 hover:text-gold-400 font-medium transition-colors px-3 py-2"
        >
          View Gallery →
        </a>
      </div>

    </div>

    <!-- Right: Image with Golden Prestige Frame -->
    <div class="lg:col-span-5 relative">
      <div class="relative">
        
        <!-- Glowing Background Aura -->
        <div class="absolute -inset-4 rounded-3xl bg-gradient-to-br from-gold-500/25 via-royal-500/20 to-gold-500/10 blur-2xl"></div>
        
        <!-- Portrait Container -->
        <div class="relative rounded-3xl overflow-hidden border-2 border-gold-500/30 shadow-2xl shadow-black/70 bg-navy-950">
          <img 
            src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjvoFHRj29vO2fQq6KMHHDpeLlL-InpJu7i2iMAkx-VUSw9vepjpeK3FxVrVtGIORUrFB3dQ3O03goEgj5f2QkugOtA0XXT0dbxohssJsvECRdBbidEVOnX0FTIKYNwAm_Jvr-Ybiv8Ah0mZ8N63-ZvhuOMrHeFRHVAFvzttofqYOqomlVXcEHDysy0VQE/s1600/WhatsApp%20Image%202026-09-02%20at%2015.41.22.jpeg" 
            alt="Dr. Pramod Kumar - National Teachers' Awardee 2025" 
            class="w-full h-auto object-cover"
          />
          
          <!-- Bottom Overlay with Name & Official Title -->
          <div class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-navy-950 via-navy-950/85 to-transparent">
            <p class="font-serif text-2xl md:text-3xl text-white font-bold leading-tight">
              Dr. Pramod Kumar
            </p>
            <p class="text-gold-400 text-xs font-semibold tracking-wider uppercase mt-1">
              National Teachers' Awardee 2025 • Govt. of India
            </p>
            <p class="text-slate-400 text-xs mt-0.5">
              Senior Master, Sainik School Nalanda
            </p>
          </div>
        </div>

        <!-- Floating Badge: 28+ Years -->
        <div class="absolute -bottom-6 -left-6 bg-white/95 backdrop-blur-md rounded-2xl p-4 shadow-2xl border border-slate-200 hidden sm:block">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-navy-950 flex items-center justify-center border border-gold-500/40">
              <span class="text-gold-400 font-bold text-lg">28+</span>
            </div>
            <div>
              <p class="text-navy-950 font-bold text-sm leading-tight">Years of</p>
              <p class="text-slate-500 text-xs uppercase tracking-wider">Dedication</p>
            </div>
          </div>
        </div>

        <!-- Floating Badge: NDA Cadets -->
        <div class="absolute -top-4 -right-4 bg-navy-900/90 backdrop-blur-md rounded-2xl px-4 py-2.5 shadow-2xl border border-gold-500/40 hidden sm:block">
          <div class="flex items-center gap-2 text-xs">
            <span class="w-2 h-2 rounded-full bg-gold-400"></span>
            <span class="text-white font-bold">168+ Cadets</span>
            <span class="text-slate-400">into NDA</span>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- Scroll Down Indicator -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 hidden lg:flex flex-col items-center gap-2 text-slate-500">
    <span class="text-[10px] tracking-widest uppercase text-slate-400">Scroll</span>
    <div class="w-px h-8 bg-gradient-to-b from-gold-500/60 to-transparent"></div>
  </div>

</section>
