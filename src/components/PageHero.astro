---
interface Props {
  label: string;
  title: string;
  highlight?: string;
  description?: string;
}

const { label, title, highlight, description } = Astro.props;
---

<section class="relative bg-navy-950 pt-40 pb-24 px-6 lg:px-10 overflow-hidden">
  
  <!-- Decorative -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-gold-500/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-royal-500/10 rounded-full blur-3xl"></div>
  
  <!-- Grid Pattern -->
  <div class="absolute inset-0 opacity-[0.03]" 
       style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 60px 60px;"></div>

  <div class="relative max-w-7xl mx-auto text-center">
    <div class="inline-flex items-center gap-2 mb-6 justify-center">
      <span class="w-12 h-px bg-gold-500"></span>
      <span class="text-gold-500 text-xs font-semibold tracking-[0.3em] uppercase">{label}</span>
      <span class="w-12 h-px bg-gold-500"></span>
    </div>
    
    <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
      {title}
      {highlight && <><br /><span class="italic text-gold-500">{highlight}</span></>}
    </h1>
    
    {description && (
      <p class="text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
        {description}
      </p>
    )}
  </div>
</section>