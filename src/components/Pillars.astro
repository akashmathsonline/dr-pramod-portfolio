<section class="relative bg-[#FAFAF7] py-24 px-6 lg:px-10">
  <div class="max-w-7xl mx-auto">
    
    <!-- Header -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 mb-6">
        <span class="w-12 h-px bg-gold-500"></span>
        <span class="text-gold-600 text-xs font-semibold tracking-[0.3em] uppercase">Impact Areas</span>
      </div>
      <h2 class="font-serif text-4xl lg:text-5xl font-bold text-navy-900 leading-tight mb-6">
        Inspiring Change Across <span class="italic text-royal-500">Indian Education</span>
      </h2>
      <p class="text-lg text-slate-600">
        Four pillars on which Dr. Kumar's lifelong mission stands — each one transforming lives and building a scientifically vibrant India.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {pillars.map((pillar, i) => (
        <div class="group bg-white rounded-3xl overflow-hidden border border-slate-200
                    hover:shadow-2xl hover:shadow-navy-900/10 hover:-translate-y-2
                    transition-all duration-500 flex flex-col">
          
          <!-- Image -->
          <div class="relative h-64 overflow-hidden bg-slate-100">
            <img src={pillar.img} alt={pillar.title} 
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute top-4 left-4">
              <span class="inline-block px-3 py-1 rounded-full bg-white/95 backdrop-blur-sm
                            text-navy-900 text-xs font-bold tracking-wider uppercase">
                {pillar.tag}
              </span>
            </div>
          </div>

          <!-- Content -->
          <div class="p-6 flex flex-col flex-1">
            <h3 class="font-serif text-xl font-bold text-navy-900 mb-3">
              {pillar.title}
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed flex-1 mb-5">
              {pillar.desc}
            </p>
            <a href="#" class="inline-flex items-center gap-2 text-royal-500 font-semibold text-xs uppercase tracking-wider
                                group-hover:gap-3 transition-all duration-300">
              Learn More
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" 
                   fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>