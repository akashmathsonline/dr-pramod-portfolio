---
const milestones = [
  {
    year: '2025',
    title: "National Teachers' Award 2025",
    org: 'Ministry of Education, Govt. of India',
    badge: 'Presidential Honor',
    desc: 'Conferred by Hon\'ble President of India Smt. Droupadi Murmu at Vigyan Bhawan, New Delhi — in recognition of 28+ years of transformative pedagogy and nation building.',
    featured: true
  },
  {
    year: '2024',
    title: '2.5 Lakh+ Teachers Mentored & MANODARPAN',
    org: 'NCERT & CBSE Counsellor Initiative',
    badge: 'National Impact',
    desc: 'Led nationwide educator capacity building programs on NEP 2020 guidelines, student psychosocial health, and experiential science lab pedagogy.',
    featured: false
  },
  {
    year: '2022',
    title: 'Regional Mentor of Change',
    org: 'NITI Aayog, Atal Innovation Mission',
    badge: 'Innovation',
    desc: 'Empowering ATL tinkering labs across Bihar and eastern India to cultivate scientific inquiry, design thinking, and grassroot innovation.',
    featured: false
  },
  {
    year: '2020',
    title: 'CBSE National Teachers\' Award & GOC Commendation',
    org: 'CBSE & GOC J&B Sub Area',
    badge: 'Dual Recognition',
    desc: 'Celebrated for academic excellence, biology curriculum development, and outstanding contribution to military training institution standards.',
    featured: true
  },
  {
    year: '2015',
    title: 'Certificate for Innovative Teaching',
    org: 'Union HRD Minister Smt. Smriti Zubin Irani',
    badge: 'Ministry Recognition',
    desc: 'Commended for pioneering participatory biology teaching methods and digital classroom integration.',
    featured: false
  },
  {
    year: '2003 - Present',
    title: 'Senior Master & HOD, Life Science',
    org: 'Sainik School Nalanda (Ministry of Defence)',
    badge: 'Armed Forces Legacy',
    desc: 'Mentored over 168+ cadets into the National Defence Academy (NDA) and Armed Forces, while steering academic leadership as Senior Master (Training).',
    featured: true
  },
  {
    year: '1996',
    title: 'Academic Foundation & Double Gold Medalist',
    org: 'Zoological & Educational Research',
    badge: 'Scholarship',
    desc: 'Gold Medalist in M.Sc. & M.A., followed by Ph.D. in Environmental Ecology & Adolescent Educational Psychology.',
    featured: false
  }
];
---

<section id="timeline" class="relative bg-navy-950 py-24 px-6 lg:px-10 overflow-hidden">
  
  <!-- Subtle Background Orbs -->
  <div class="absolute top-1/3 -left-32 w-96 h-96 bg-royal-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 right-0 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-20">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold tracking-[0.2em] uppercase mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-gold-400 animate-pulse"></span>
        28+ Years Journey • 1996 — 2025
      </div>
      <h2 class="font-serif text-4xl lg:text-5xl font-bold text-white leading-tight mb-5">
        A Chronicle of <span class="italic text-transparent bg-clip-text bg-gradient-to-r from-gold-400 to-gold-600">Educational Leadership</span>
      </h2>
      <p class="text-slate-400 text-base md:text-lg leading-relaxed">
        Key milestones reflecting dedication to the cadets of Sainik School Nalanda, national curriculum reform, and thousands of educators across India.
      </p>
    </div>

    <!-- Timeline Container -->
    <div class="relative">
      
      <!-- Center Vertical Gold Line -->
      <div class="hidden md:block absolute left-1/2 top-4 bottom-4 -translate-x-1/2 w-0.5 bg-gradient-to-b from-gold-500/80 via-gold-500/30 to-transparent"></div>

      <!-- Timeline Items -->
      <div class="space-y-12 md:space-y-16">
        {milestones.map((item, index) => {
          const isEven = index % 2 === 0;
          return (
            <div class={`relative flex flex-col md:flex-row items-center ${isEven ? 'md:flex-row-reverse' : ''}`}>
              
              <!-- Content Card -->
              <div class="w-full md:w-[46%]">
                <div class={`group p-8 rounded-3xl border transition-all duration-500 
                             ${item.featured 
                               ? 'bg-gradient-to-br from-navy-900 via-navy-900 to-navy-850 border-gold-500/40 shadow-2xl shadow-gold-500/10 hover:border-gold-500' 
                               : 'bg-navy-900/60 border-white/10 hover:border-white/20'}`}>
                  
                  <div class="flex items-center justify-between gap-3 mb-4">
                    <span class={`text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider 
                                  ${item.featured 
                                    ? 'bg-gold-500 text-navy-950 font-extrabold' 
                                    : 'bg-white/10 text-slate-300'}`}>
                      {item.badge}
                    </span>
                    <span class="font-serif text-xl font-bold text-gold-400 tracking-wide">
                      {item.year}
                    </span>
                  </div>

                  <h3 class="font-serif text-2xl font-bold text-white mb-2 leading-snug group-hover:text-gold-300 transition-colors">
                    {item.title}
                  </h3>

                  <p class="text-xs font-semibold text-royal-500 mb-3 tracking-wider uppercase">
                    {item.org}
                  </p>

                  <p class="text-sm text-slate-300 leading-relaxed">
                    {item.desc}
                  </p>
                </div>
              </div>

              <!-- Center Marker Dot -->
              <div class="hidden md:flex absolute left-1/2 -translate-x-1/2 w-10 h-10 rounded-full items-center justify-center bg-navy-950 border-2 border-gold-500 shadow-xl shadow-gold-500/20 z-10">
                <div class="w-3.5 h-3.5 rounded-full bg-gold-400"></div>
              </div>

              <!-- Empty space for the other side -->
              <div class="hidden md:block w-[46%]"></div>

            </div>
          );
        })}
      </div>

    </div>

  </div>
</section>
