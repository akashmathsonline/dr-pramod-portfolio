---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Dr. Pramod Kumar - Senior Master (Training) & HOD Life Science at Sainik School Nalanda. National Teachers' Award 2025 recipient. CBSE Master Trainer who has mentored 2.5 lakh+ educators across India.",
  image = "/og-image.jpg"
} = Astro.props;

const siteUrl = "https://drpramodkumar.vercel.app";
const fullImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || siteUrl);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Dr. Pramod Kumar" />
    <meta name="keywords" content="Dr. Pramod Kumar, Sainik School Nalanda, National Teachers Award 2025, CBSE Master Trainer, Educational Psychology, Life Science HOD, NEP 2020, Atal Tinkering Labs, NITI Aayog Mentor" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="English" />
    <meta name="theme-color" content="#0a1628" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Dr. Pramod Kumar" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Schema.org Structured Data (Google Rich Results) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Dr. Pramod Kumar",
      "jobTitle": "Senior Master (Training) & HOD, Life Science",
      "worksFor": {
        "@type": "Organization",
        "name": "Sainik School Nalanda, Ministry of Defence, Govt. of India"
      },
      "alumniOf": {
        "@type": "University",
        "name": "B.R.A. Bihar University, Muzaffarpur"
      },
      "award": [
        "National Teachers' Award 2025",
        "CBSE National Teachers' Award 2020"
      ],
      "email": "dkpramodkumar@gmail.com",
      "telephone": "+91-9973715354",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Nalanda",
        "addressRegion": "Bihar",
        "postalCode": "803115",
        "addressCountry": "IN"
      },
      "url": siteUrl
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>