---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';

const contactInfo = [
  {
    icon: 'email',
    label: 'Email',
    value: 'dkpramodkumar@gmail.com',
    href: 'mailto:dkpramodkumar@gmail.com',
    description: 'For academic collaborations & speaking'
  },
  {
    icon: 'phone',
    label: 'Phone',
    value: '+91 99737 15354',
    href: 'tel:+919973715354',
    description: 'Available 9 AM - 6 PM IST'
  },
  {
    icon: 'location',
    label: 'Office',
    value: 'Sainik School Nalanda',
    href: 'https://maps.google.com/?q=Sainik+School+Nalanda',
    description: 'Village Nanand, PO Pawapuri, Bihar - 803115'
  },
];
---

<Layout title="Contact - Dr. Pramod Kumar">
  <Navbar />
  <main>
    <PageHero 
      label="Get in Touch"
      title="Let's Work"
      highlight="Together"
      description="Whether you're an educator seeking mentorship, a school looking for training, or a researcher interested in collaboration — I'd love to hear from you."
    />

    <section class="bg-[#FAFAF7] py-24 px-6 lg:px-10">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-12 gap-12">
        
        <!-- Left: Contact Info -->
        <div class="lg:col-span-5 space-y-6">
          <div>
            <h2 class="font-serif text-3xl font-bold text-navy-900 mb-3">
              Contact Information
            </h2>
            <p class="text-slate-600 mb-8">
              Reach out through any of these channels. I typically respond within 24-48 hours.
            </p>
          </div>

          {contactInfo.map((item) => (
            <a href={item.href} target="_blank" rel="noopener noreferrer" 
               class="group block bg-white rounded-2xl p-6 border border-slate-200 
                      hover:border-gold-500/50 hover:shadow-xl hover:shadow-navy-900/5 
                      transition-all duration-300">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-navy-900 flex items-center justify-center flex-shrink-0
                            group-hover:bg-gold-500 transition-colors duration-300">
                  {item.icon === 'email' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" 
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         class="text-white group-hover:text-navy-900 transition-colors">
                      <rect width="20" height="16" x="2" y="4" rx="2"/>
                      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                    </svg>
                  )}
                  {item.icon === 'phone' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" 
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         class="text-white group-hover:text-navy-900 transition-colors">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                  )}
                  {item.icon === 'location' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" 
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         class="text-white group-hover:text-navy-900 transition-colors">
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                  )}
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">
                    {item.label}
                  </p>
                  <p class="font-serif font-bold text-navy-900 mb-1 break-words">
                    {item.value}
                  </p>
                  <p class="text-xs text-slate-500">
                    {item.description}
                  </p>
                </div>
              </div>
            </a>
          ))}

          <!-- Social Links Hint -->
          <div class="pt-6 border-t border-slate-200">
            <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">
              Connect on Social
            </p>
            <div class="flex gap-3">
              <a href="#" class="w-10 h-10 rounded-full bg-navy-900 text-white flex items-center justify-center
                                  hover:bg-gold-500 hover:text-navy-900 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
              <a href="#" class="w-10 h-10 rounded-full bg-navy-900 text-white flex items-center justify-center
                                  hover:bg-gold-500 hover:text-navy-900 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.405a1.44 1.44 0 112.881.001 1.44 1.44 0 01-2.881-.001z"/>
                </svg>
              </a>
              <a href="#" class="w-10 h-10 rounded-full bg-navy-900 text-white flex items-center justify-center
                                  hover:bg-gold-500 hover:text-navy-900 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Right: Contact Form -->
        <div class="lg:col-span-7">
          <div class="bg-white rounded-3xl p-8 lg:p-10 border border-slate-200 shadow-xl shadow-navy-900/5">
            <h2 class="font-serif text-3xl font-bold text-navy-900 mb-3">
              Send a Message
            </h2>
            <p class="text-slate-600 mb-8">
              Fill out the form below and I'll get back to you personally.
            </p>

            <form 
              id="contactForm"
              action="https://formspree.io/f/xyzabc123" 
              method="POST"
              class="space-y-6"
            >
              <!-- Name + Email -->
              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="name" class="block text-xs font-bold text-navy-900 uppercase tracking-wider mb-2">
                    Your Name *
                  </label>
                  <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    required
                    class="w-full px-5 py-3.5 rounded-xl border border-slate-200 
                           focus:border-gold-500 focus:ring-2 focus:ring-gold-500/20 
                           outline-none transition-all duration-300
                           text-navy-900 placeholder:text-slate-400"
                    placeholder="Dr. A. K. Sharma"
                  />
                </div>
                <div>
                  <label for="email" class="block text-xs font-bold text-navy-900 uppercase tracking-wider mb-2">
                    Email *
                  </label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    required
                    class="w-full px-5 py-3.5 rounded-xl border border-slate-200 
                           focus:border-gold-500 focus:ring-2 focus:ring-gold-500/20 
                           outline-none transition-all duration-300
                           text-navy-900 placeholder:text-slate-400"
                    placeholder="you@example.com"
                  />
                </div>
              </div>

              <!-- Subject -->
              <div>
                <label for="subject" class="block text-xs font-bold text-navy-900 uppercase tracking-wider mb-2">
                  Subject *
                </label>
                <input 
                  type="text" 
                  id="subject" 
                  name="subject" 
                  required
                  class="w-full px-5 py-3.5 rounded-xl border border-slate-200 
                         focus:border-gold-500 focus:ring-2 focus:ring-gold-500/20 
                         outline-none transition-all duration-300
                         text-navy-900 placeholder:text-slate-400"
                  placeholder="Training request, collaboration, or inquiry"
                />
              </div>

              <!-- Purpose -->
              <div>
                <label for="purpose" class="block text-xs font-bold text-navy-900 uppercase tracking-wider mb-2">
                  Purpose
                </label>
                <select 
                  id="purpose" 
                  name="purpose"
                  class="w-full px-5 py-3.5 rounded-xl border border-slate-200 
                         focus:border-gold-500 focus:ring-2 focus:ring-gold-500/20 
                         outline-none transition-all duration-300
                         text-navy-900 bg-white">
                  <option value="mentorship">Mentorship / Guidance</option>
                  <option value="training">Teacher Training Request</option>
                  <option value="collaboration">Research Collaboration</option>
                  <option value="speaking">Speaking Engagement</option>
                  <option value="counselling">Student Counselling</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <!-- Message -->
              <div>
                <label for="message" class="block text-xs font-bold text-navy-900 uppercase tracking-wider mb-2">
                  Message *
                </label>
                <textarea 
                  id="message" 
                  name="message" 
                  required
                  rows="6"
                  class="w-full px-5 py-3.5 rounded-xl border border-slate-200 
                         focus:border-gold-500 focus:ring-2 focus:ring-gold-500/20 
                         outline-none transition-all duration-300 resize-none
                         text-navy-900 placeholder:text-slate-400"
                  placeholder="Tell me a bit about your inquiry..."></textarea>
              </div>

              <!-- Submit -->
              <button 
                type="submit"
                class="group w-full md:w-auto inline-flex items-center justify-center gap-3 
                       px-8 py-4 rounded-full
                       bg-gradient-to-r from-gold-500 to-gold-600
                       text-navy-900 font-semibold text-sm uppercase tracking-wider
                       hover:shadow-2xl hover:shadow-gold-500/30 
                       transition-all duration-300 hover:-translate-y-0.5">
                Send Message
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" 
                     fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                     class="group-hover:translate-x-1 transition-transform">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </button>

              <!-- Note -->
              <p class="text-xs text-slate-500 text-center md:text-left pt-2">
                📧 Form is currently in preview mode. For urgent inquiries, please email directly at 
                <a href="mailto:dkpramodkumar@gmail.com" class="text-royal-500 hover:underline font-medium">
                  dkpramodkumar@gmail.com
                </a>
              </p>
            </form>
          </div>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>