    title: 'Dr. Pramod Kumar',
    category: 'Portrait',
  },
  {
    src: 'https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEi_oqmkBetzIqUnPhicZdo5ldPdWdUOqZMM1Eb-ZiZ6e_baa7w8AVF1GYypR00Izr9CALZiwHTgpc-7sTNZze4IZBkuHtfCTuGjGG5MK_945emy0DqYEXA7VjwKTorHuxKB8nvZT5f5dhmgKEjYfyuRL_g-0RKscv-bWzI-I3z5OOrnRY8TSwcyR3zBWcQ/s1600/WhatsApp%20Image%202026-09-02%20at%2015.41.25.jpeg',
    title: 'Receiving National Recognition',
    category: 'Awards',
  },
  {
    src: 'https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEh0qEStekO_-TfmtSBPaB8VpBLvT7HK9XvV2g6nrjmC6MqlQeDtvRB5lKMdUtyxSu3MdBHX1IM1sythF9NhAyv1fQQMZvi7m5H63fBbwgsmE7SSIyhi-FIKBm-FTapOsJPSYKXNUsv4E0ljUvw7UHe62WZB_ml7dAvuEZ_vNpLVu6MrmtzV6quYWpgu23w/s1600/WhatsApp%20Image%202026-09-02%20at%2015.41.32.jpeg',
    title: 'CBSE Training Session',
    category: 'Training',
  },
  {
    src: 'https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjoTLmnC0OxGmfC6oNebwjjFgQ3Gr7f4Eh2_GIDXjUZIRlDSeHMrhR1-jNsSzVSnew6dtoxeALUvndyV-P1-LaFXxnl80gtQOTrzPUA7Ptw0Xfrho7xtpN5tGassbKjjGAVRNbpoBonzWufzWyuZax7CejvykQ6VcI6TzRmDYNIk85JUU6cRw1TTyuQ-jo/s1600/WhatsApp%20Image%202026-09-02%20at%2015.41.30%20%281%29.jpeg',
    title: 'With Educators & Faculty',
    category: 'Events',
  },
  {
    src: 'https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhfI3d5Cj1z042ZSQiFS8hr_jSVIZrya6lIsxIK1nj1Tu_KKBs0mQKbaQAipQrPwGBILX4qQwGZh-MdEpXrye3Q8fmvrbPZgCt4ACOS_LAcPHMRxlDhcp3pXAE76V7KelD0TTdn6TrG8_dZo_DiDS8NdIWk11n5nVSPbNL8P68IttknGBTRJYF-XApwdXU/s1600/WhatsApp%20Image%202026-09-02%20at%2015.41.30.jpeg',
    title: 'Sainik School Nalanda',
    category: 'Campus',
  },
];
---

<Layout title="Gallery - Dr. Pramod Kumar">
  <Navbar />
  <main>
    <PageHero 
      label="Gallery"
      title="Moments of"
      highlight="Impact"
      description="A visual journey through milestones, training sessions, national recognitions, and the everyday work of transforming Indian education."
    />

    <section class="bg-[#FAFAF7] py-24 px-6 lg:px-10">
      <div class="max-w-7xl mx-auto">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {photos.map((photo, i) => (
            <div class={`group relative overflow-hidden rounded-2xl bg-navy-900 cursor-pointer
                        reveal reveal-delay-${(i % 6) + 1}
                        ${i === 0 ? 'lg:col-span-2 lg:row-span-2' : ''}`}>
              <div class={`${i === 0 ? 'aspect-square lg:aspect-auto lg:h-full' : 'aspect-square'} relative`}>
                <img 
                  src={photo.src} 
                  alt={photo.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  loading="lazy"
                />
                
                <!-- Overlay -->
                <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/30 to-transparent 
                            opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                
                <!-- Content -->
                <div class="absolute bottom-0 left-0 right-0 p-6 translate-y-4 
                            group-hover:translate-y-0 opacity-0 group-hover:opacity-100 
                            transition-all duration-500">
                  <span class="inline-block px-3 py-1 rounded-full bg-gold-500 text-navy-900 
                                text-xs font-bold tracking-wider uppercase mb-3">
                    {photo.category}
                  </span>
                  <h3 class="font-serif text-2xl font-bold text-white">
                    {photo.title}
                  </h3>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Coming Soon Note -->
        <div class="mt-16 text-center p-8 rounded-2xl border-2 border-dashed border-slate-300">
          <p class="text-slate-500">
            📸 <span class="font-semibold text-navy-900">More photos coming soon</span> — 
            event galleries, award ceremonies, and classroom moments.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  // Simple gallery interaction - open image in new tab for now
  document.querySelectorAll('.group.cursor-pointer').forEach((item) => {
    item.addEventListener('click', () => {
      const img = item.querySelector('img');
      if (img) {
        window.open(img.src, '_blank');
      }
    });
  });
</script>