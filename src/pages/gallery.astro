---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
import { getGalleryPhotos, urlFor } from '../lib/sanity';

const rawPhotos = await getGalleryPhotos();

const photos = rawPhotos.map((photo: any) => ({
  id: photo._id,
  title: photo.title,
  category: photo.category || 'General',
  date: photo.date || '2024-2025',
  description: photo.description || 'Milestones of dedication and excellence in Indian Education.',
  src: photo.imageUrl || (photo.image ? urlFor(photo.image).width(1200).url() : 'https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjvoFHRj29vO2fQq6KMHHDpeLlL-InpJu7i2iMAkx-VUSw9vepjpeK3FxVrVtGIORUrFB3dQ3O03goEgj5f2QkugOtA0XXT0dbxohssJsvECRdBbidEVOnX0FTIKYNwAm_Jvr-Ybiv8Ah0mZ8N63-ZvhuOMrHeFRHVAFvzttofqYOqomlVXcEHDysy0VQE/s1600/WhatsApp%20Image%202026-09-02%20at%2015.41.22.jpeg')
}));

const categories = [
  { label: 'All Photos / सभी', value: 'all' },
  { label: 'Awards / सम्मान', value: 'Awards' },
  { label: 'Sainik School / सैनिक स्कूल', value: 'Sainik School' },
  { label: 'Training / प्रशिक्षण', value: 'Training' },
  { label: 'Curriculum / नवाचार', value: 'Curriculum' },
  { label: 'Leadership / नेतृत्व', value: 'Leadership' }
];
---

<Layout title="Gallery - Dr. Pramod Kumar | Moments of Impact">
  <Navbar />
  <main>
    <PageHero 
      label="Visual Journey"
      title="Moments of"
      highlight="Legacy & Impact"
      description="A visual chronicle of 28+ years: from presidential honors at Vigyan Bhawan to classroom mentorship at Sainik School Nalanda."
    />

    <section class="bg-[#FAFAF7] py-20 px-6 lg:px-10">
      <div class="max-w-7xl mx-auto">
        
        <!-- Category Filter Tabs -->
        <div class="flex flex-wrap items-center justify-center gap-3 mb-14">
          {categories.map((cat, i) => (
            <button
              type="button"
              data-filter={cat.value}
              class={`filter-btn px-5 py-2.5 rounded-full text-xs font-semibold tracking-wider transition-all duration-300 cursor-pointer
                      ${i === 0 
                        ? 'bg-navy-900 text-gold-400 shadow-md ring-2 ring-navy-900' 
                        : 'bg-white text-slate-600 hover:text-navy-900 hover:bg-slate-100 border border-slate-200'}`}
            >
              {cat.label}
            </button>
          ))}
        </div>

        <!-- Photos Grid -->
        <div id="gallery-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {photos.map((photo: any, i: number) => (
            <div 
              data-category={photo.category}
              data-index={i}
              class="gallery-item group relative rounded-3xl overflow-hidden bg-navy-950 border border-slate-200/80 
                     shadow-lg hover:shadow-2xl hover:shadow-navy-950/20 hover:-translate-y-1.5 transition-all duration-500 cursor-pointer"
            >
              <!-- Image Container -->
              <div class="aspect-[4/3] overflow-hidden relative">
                <img 
                  src={photo.src} 
                  alt={photo.title}
                  class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700 ease-out"
                  loading="lazy"
                />
                
                <!-- Overlay Gradient -->
                <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/40 to-transparent 
                            opacity-60 group-hover:opacity-90 transition-opacity duration-300"></div>

                <!-- Category Badge -->
                <div class="absolute top-4 left-4 z-10">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-navy-900/80 backdrop-blur-md border border-gold-500/40 text-gold-400 text-[11px] font-bold tracking-wider uppercase">
                    <span class="w-1.5 h-1.5 rounded-full bg-gold-400"></span>
                    {photo.category}
                  </span>
                </div>

                <!-- Date Badge -->
                <div class="absolute top-4 right-4 z-10">
                  <span class="px-2.5 py-1 rounded-lg bg-black/40 backdrop-blur-md text-white/90 text-[11px] font-medium">
                    {photo.date}
                  </span>
                </div>

                <!-- Click to zoom indicator -->
                <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10 pointer-events-none">
                  <span class="p-3.5 rounded-full bg-gold-500 text-navy-950 shadow-xl transform scale-75 group-hover:scale-100 transition-transform duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="11" cy="11" r="8"></circle>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                      <line x1="11" y1="8" x2="11" y2="14"></line>
                      <line x1="8" y1="11" x2="14" y2="11"></line>
                    </svg>
                  </span>
                </div>

                <!-- Bottom Details -->
                <div class="absolute bottom-0 left-0 right-0 p-6 z-10">
                  <h3 class="font-serif text-xl font-bold text-white group-hover:text-gold-300 transition-colors leading-snug mb-1">
                    {photo.title}
                  </h3>
                  <p class="text-xs text-slate-300 line-clamp-2 leading-relaxed">
                    {photo.description}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Empty State (hidden by default) -->
        <div id="empty-state" class="hidden text-center py-20">
          <p class="text-slate-400 text-lg">इस श्रेणी में अभी कोई तस्वीर नहीं है।</p>
        </div>

      </div>
    </section>

    <!-- Lightbox Modal -->
    <div 
      id="lightbox" 
      class="fixed inset-0 z-50 bg-navy-950/95 backdrop-blur-xl opacity-0 pointer-events-none transition-opacity duration-300 flex items-center justify-center p-4 md:p-8"
      role="dialog"
      aria-modal="true"
    >
      <!-- Close Button -->
      <button 
        id="lightbox-close" 
        class="absolute top-6 right-6 z-50 w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white flex items-center justify-center transition-all cursor-pointer"
        aria-label="Close dialog"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <!-- Lightbox Content Container -->
      <div class="relative max-w-5xl w-full max-h-[90vh] flex flex-col md:flex-row bg-navy-900 rounded-3xl overflow-hidden border border-gold-500/30 shadow-2xl">
        
        <!-- Image Pane -->
        <div class="flex-1 bg-black/60 flex items-center justify-center p-4 min-h-[350px] md:min-h-[500px]">
          <img 
            id="lightbox-img" 
            src="" 
            alt="" 
            class="max-w-full max-h-[75vh] object-contain rounded-xl shadow-2xl transition-all duration-300"
          />
        </div>

        <!-- Sidebar Info Pane -->
        <div class="w-full md:w-80 p-6 md:p-8 flex flex-col justify-between bg-navy-900 border-t md:border-t-0 md:border-l border-white/10">
          <div>
            <div class="flex items-center gap-2 mb-4">
              <span id="lightbox-category" class="px-3 py-1 rounded-full bg-gold-500/20 text-gold-400 border border-gold-500/40 text-xs font-bold uppercase tracking-wider">
                Award
              </span>
              <span id="lightbox-date" class="text-xs text-slate-400">
                2025
              </span>
            </div>

            <h3 id="lightbox-title" class="font-serif text-2xl font-bold text-white mb-4 leading-snug">
              Photo Title
            </h3>

            <p id="lightbox-desc" class="text-sm text-slate-300 leading-relaxed mb-6">
              Detailed description of this milestone.
            </p>
          </div>

          <div class="pt-6 border-t border-white/10">
            <p class="text-xs text-slate-400 tracking-wide">
              Official Archive • Dr. Pramod Kumar Portfolio
            </p>
          </div>
        </div>

      </div>
    </div>

  </main>
  <Footer />
</Layout>

<script define:vars={{ photos }}>
  // Category Filtering Logic
  const filterButtons = document.querySelectorAll('.filter-btn');
  const galleryItems = document.querySelectorAll('.gallery-item');
  const emptyState = document.getElementById('empty-state');

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      filterButtons.forEach(b => {
        b.classList.remove('bg-navy-900', 'text-gold-400', 'ring-2', 'ring-navy-900');
        b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      });
      btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      btn.classList.add('bg-navy-900', 'text-gold-400', 'ring-2', 'ring-navy-900');

      const filter = btn.getAttribute('data-filter');
      let visibleCount = 0;

      galleryItems.forEach(item => {
        const itemCat = item.getAttribute('data-category');
        if (filter === 'all' || itemCat === filter) {
          (item as HTMLElement).style.display = 'block';
          visibleCount++;
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    });
  });

  // Lightbox Modal Logic
  const lightbox = document.getElementById('lightbox');
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxCat = document.getElementById('lightbox-category');
  const lightboxDate = document.getElementById('lightbox-date');
  const lightboxDesc = document.getElementById('lightbox-desc');

  function openLightbox(index: number) {
    const data = photos[index];
    if (!data || !lightbox || !lightboxImg) return;

    lightboxImg.src = data.src;
    lightboxImg.alt = data.title;
    if (lightboxTitle) lightboxTitle.textContent = data.title;
    if (lightboxCat) lightboxCat.textContent = data.category;
    if (lightboxDate) lightboxDate.textContent = data.date;
    if (lightboxDesc) lightboxDesc.textContent = data.description;

    lightbox.classList.remove('opacity-0', 'pointer-events-none');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
  }

  galleryItems.forEach(item => {
    item.addEventListener('click', () => {
      const idx = parseInt(item.getAttribute('data-index') || '0', 10);
      openLightbox(idx);
    });
  });

  if (lightboxClose) {
    lightboxClose.addEventListener('click', closeLightbox);
  }

  if (lightbox) {
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        closeLightbox();
      }
    });
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
